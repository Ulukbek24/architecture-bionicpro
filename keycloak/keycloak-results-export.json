{
  "id": "reports-realm",
  "realm": "reports-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "id": "r-user",          "name": "user",           "description": "Regular user role" },
      { "id": "r-administrator", "name": "administrator",  "description": "Administrator role" },
      { "id": "r-prothetic",     "name": "prothetic_user", "description": "Prothetic user role with report access" }
    ]
  },
  "users": [
    {
      "id": "u-user1",
      "username": "user1",
      "enabled": true,
      "email": "user1@example.com",
      "firstName": "User",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "id": "u-user2",
      "username": "user2",
      "enabled": true,
      "email": "user2@example.com",
      "firstName": "User",
      "lastName": "Two",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "id": "u-admin1",
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "firstName": "Admin",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["administrator"]
    },
    {
      "id": "u-prothetic1",
      "username": "prothetic1",
      "enabled": true,
      "email": "prothetic1@example.com",
      "firstName": "Prothetic",
      "lastName": "One",
      "attributes": { "prosthetic_ids": ["P-1001", "P-1002"] },
      "credentials": [{ "type": "password", "value": "prothetic123", "temporary": false }],
      "realmRoles": ["prothetic_user"]
    },
    {
      "id": "u-prothetic2",
      "username": "prothetic2",
      "enabled": true,
      "email": "prothetic2@example.com",
      "firstName": "Prothetic",
      "lastName": "Two",
      "attributes": { "prosthetic_ids": ["P-2001"] },
      "credentials": [{ "type": "password", "value": "prothetic123", "temporary": false }],
      "realmRoles": ["prothetic_user"]
    },
    {
      "id": "u-prothetic3",
      "username": "prothetic3",
      "enabled": true,
      "email": "prothetic3@example.com",
      "firstName": "Prothetic",
      "lastName": "Three",
      "attributes": { "prosthetic_ids": ["P-3001", "P-3002", "P-3003"] },
      "credentials": [{ "type": "password", "value": "prothetic123", "temporary": false }],
      "realmRoles": ["prothetic_user"]
    }
  ],
  "clients": [
    {
      "id": "c-reports-frontend",
      "clientId": "reports-frontend",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "frontend-bff-secret-do-not-use-in-prod",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8000/auth/callback",
        "http://localhost:8000/*"
      ],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "id": "pm-prosthetic-ids",
          "name": "prosthetic_ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "prosthetic_ids",
            "claim.name": "prosthetic_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "id": "c-reports-api",
      "clientId": "reports-api",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "oNwoLQdvJAvRcL89SydqCWCe5ry1jMgq",
      "bearerOnly": true
    }
  ],
  "identityProviders": [
    {
      "alias": "yandex",
      "displayName": "Yandex ID",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "authorizationUrl": "https://oauth.yandex.ru/authorize",
        "tokenUrl": "https://oauth.yandex.ru/token",
        "userInfoUrl": "https://login.yandex.ru/info?format=json",
        "clientId": "yandex-client-id-placeholder",
        "clientSecret": "yandex-client-secret-placeholder",
        "defaultScope": "login:email login:info",
        "clientAuthMethod": "client_secret_post",
        "syncMode": "IMPORT",
        "pkceEnabled": "true",
        "pkceMethod": "S256"
      }
    }
  ]
}
